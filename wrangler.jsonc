{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drrajeevagarwal",
  "compatibility_date": "2026-07-14",
  "main": "./src/worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    // Every real route is prerendered to its own file, so anything without a file
    // genuinely does not exist and must say so. "single-page-application" answered
    // 200 with the homepage for junk URLs, old blog permalinks and /wp-admin —
    // soft 404s that Google reads as duplicate homepage content.
    "not_found_handling": "404-page",
    // The Worker runs first for every request (run_worker_first = true below) and
    // hands anything it does not handle itself to the prerendered assets. It owns:
    //   /api/*         — lead + workshop webhook proxies
    //   /.well-known/* — 404 unpublished discovery documents instead of serving HTML
    //   /wp-*          — legacy WordPress paths that must answer 410 Gone / 403,
    //                    which _redirects cannot express (3xx only)
    //   /xmlrpc.php    — 403 Forbidden
    // /wp-styles/* is excluded: those are real stylesheets this site still serves.
    // Legacy 301s (retired /blog/<slug> article URLs, /preconception-care, /feed,
    // /author/*) live in src/worker.js. The generated _redirects file mirrors the
    // 301s only as a fallback: Cloudflare does not apply it to Worker-served requests.
    "run_worker_first": true,
    // Every prerendered page lives at <route>/index.html. The default
    // ("auto-trailing-slash") answers /about-me with a 307 to /about-me/, which
    // would make every canonical tag and every sitemap URL redirect. Serve them at
    // the no-slash form instead, matching those URLs exactly. The one exception is
    // blog articles, whose canonical is /<slug>/: src/worker.js (articleAssetRequest)
    // serves that form directly so it answers 200 rather than 307.
    "html_handling": "drop-trailing-slash"
  }
}
